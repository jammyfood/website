---
import '../styles/global.css';
import Strawberry from '../components/Strawberry.astro';
const { title, active = 'about' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const link = (path = '') => `${base}/${path}`;
const nav = [
  { key: 'about', label: 'About me', path: '' },
  { key: 'philosophy', label: 'Philosophy', path: 'philosophy/' },
  { key: 'resume', label: 'Resume', path: 'resume/' },
  { key: 'lessons', label: 'Lesson plans', path: 'lesson-plans/' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Jamily Lee’s music education portfolio. A place for musical experiences, teaching ideas, and reflections." />
    <title>{title} · Jamily Lee</title>
    <link rel="icon" type="image/svg+xml" href={link('favicon.svg')} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="shell">
      <header class="header">
        <a class="wordmark" href={link()} aria-label="Jamily Lee, home"><span class="brand-berry"><Strawberry /></span> jamily’s little website</a>
        <nav aria-label="Main navigation">
          {nav.map(item => <a href={link(item.path)} aria-current={active === item.key ? 'page' : undefined}>{item.label}</a>)}
        </nav>
      </header>
      <main id="main"><slot /></main>
      <footer><span>Jamily Lee’s music education portfolio</span></footer>
    </div>
  </body>
</html>
