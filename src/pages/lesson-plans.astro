---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Lesson plans" active="lessons">
  <section class="simple-page sparse-page lesson-page">
    <h1>Lesson plans</h1>
    <button type="button" class="lesson-button" id="lesson-button">Book a lesson <span aria-hidden="true">↗</span></button>
    <audio id="lesson-audio" preload="none" src="https://www.myinstants.com/media/sounds/asian-gong-music.mp3"></audio>
  </section>
</Layout>
<script>
  const button = document.querySelector<HTMLButtonElement>('#lesson-button');
  const audio = document.querySelector<HTMLAudioElement>('#lesson-audio');
  button?.addEventListener('click', () => {
    if (!audio) return;
    audio.pause();
    audio.currentTime = 0;
    void audio.play().catch(() => {});
  });
</script>
