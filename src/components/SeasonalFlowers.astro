<canvas class="flower-shower" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.flower-shower');
  const context = canvas?.getContext('2d');
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let flowers: { x: number; y: number; size: number; speed: number; drift: number; angle: number; spin: number; phase: number }[] = [];
  let width = 0;
  let height = 0;
  let frame = 0;
  let previous = 0;
  let active = false;

  function resize() {
    if (!canvas || !context) return;
    width = window.innerWidth;
    height = window.innerHeight;
    const ratio = Math.min(window.devicePixelRatio || 1, 2);
    canvas.width = width * ratio;
    canvas.height = height * ratio;
    context.setTransform(ratio, 0, 0, ratio, 0, 0);
  }

  function launchBurst() {
    if (motion.matches || document.hidden) return;
    const count = width < 620 ? 36 : 56;
    flowers = Array.from({ length: count }, () => ({
      x: Math.random() * width,
      y: -Math.random() * height * 0.7,
      size: 16 + Math.random() * 10,
      speed: (190 + Math.random() * 120) * 0.7,
      drift: 12 + Math.random() * 24,
      angle: Math.random() * Math.PI * 2,
      spin: (Math.random() - 0.5) * 0.55,
      phase: Math.random() * Math.PI * 2,
    }));
    active = true;
    start();
  }

  function drawFlower(size: number) {
    if (!context) return;
    context.save();
    context.scale(size / 60, size / 60);
    for (let petal = 0; petal < 5; petal++) {
      context.save();
      context.rotate((petal * Math.PI * 2) / 5);
      context.fillStyle = '#ec9eb1';
      context.beginPath();
      context.moveTo(0, -8);
      context.bezierCurveTo(-16, -19, -38, -39, -34, -51);
      context.bezierCurveTo(-30, -66, -8, -61, 0, -39);
      context.bezierCurveTo(8, -61, 30, -66, 34, -51);
      context.bezierCurveTo(38, -39, 16, -19, 0, -8);
      context.fill();
      context.fillStyle = '#f5c1ce';
      context.beginPath();
      context.ellipse(-10, -42, 5, 13, -0.4, 0, Math.PI * 2);
      context.fill();
      context.restore();
    }
    context.fillStyle = '#f4dce4';
    context.beginPath();
    context.arc(0, 0, 8, 0, Math.PI * 2);
    context.fill();
    context.strokeStyle = '#f989a7';
    context.lineWidth = 2.5;
    for (let i = 0; i < 5; i++) {
      const angle = (i * Math.PI * 2) / 5;
      context.beginPath();
      context.moveTo(0, 2);
      context.lineTo(Math.cos(angle) * 17, Math.sin(angle) * 17);
      context.stroke();
      context.fillStyle = '#f989a7';
      context.beginPath();
      context.arc(Math.cos(angle) * 17, Math.sin(angle) * 17, 2.5, 0, Math.PI * 2);
      context.fill();
    }
    context.restore();
  }

  function animate(now: number) {
    if (!context || !canvas || motion.matches || document.hidden || !active) return;
    const delta = Math.min((now - previous) / 1000, 0.05);
    previous = now;
    context.clearRect(0, 0, width, height);
    let visible = false;
    for (const flower of flowers) {
      flower.y += flower.speed * delta;
      flower.x += (Math.sin(now / 1500 + flower.phase) * flower.drift) * delta / 3;
      flower.angle += flower.spin * delta;
      context.save();
      context.globalAlpha = 0.92;
      context.translate(flower.x, flower.y);
      context.rotate(flower.angle);
      drawFlower(flower.size);
      context.restore();
      if (flower.y <= height + flower.size * 2) visible = true;
    }
    if (!visible) {
      context.clearRect(0, 0, width, height);
      active = false;
      frame = 0;
      return;
    }
    frame = requestAnimationFrame(animate);
  }

  function start() {
    cancelAnimationFrame(frame);
    if (motion.matches || document.hidden || !active) return;
    previous = performance.now();
    frame = requestAnimationFrame(animate);
  }

  resize();
  launchBurst();
  const burstTimer = window.setInterval(launchBurst, 30_000);
  window.addEventListener('resize', resize);
  document.addEventListener('visibilitychange', start);
  motion.addEventListener('change', () => {
    if (motion.matches) {
      active = false;
      cancelAnimationFrame(frame);
      context?.clearRect(0, 0, width, height);
    } else launchBurst();
  });
  window.addEventListener('pagehide', () => window.clearInterval(burstTimer), { once: true });
</script>

<style>
  .flower-shower{position:fixed;inset:0;width:100vw;height:100vh;z-index:45;pointer-events:none}
  @media(prefers-reduced-motion:reduce){.flower-shower{display:none}}
</style>
